# Copy to .env and fill in. The server reads these at startup.

# Path to your scope file (the allowlist of targets you are authorized to test).
# If unset, defaults to ./scope.yaml
RECON_BRIDGE_SCOPE=./scope.yaml

# Where audit records are written (one JSON object per line).
# If unset, defaults to ./logs/audit.jsonl
RECON_BRIDGE_AUDIT_LOG=./logs/audit.jsonl

# Global rate limit: max tool invocations per minute across all tools.
RECON_BRIDGE_RATE_PER_MIN=30

# Set to "1" to run in dry-run mode: every tool validates scope and logs,
# but does NOT execute the underlying command. Useful for demos and tests.
RECON_BRIDGE_DRY_RUN=0

# Only needed for the ChatGPT / OpenAI bridge (bridge_openai.py).
# OPENAI_API_KEY=sk-...
